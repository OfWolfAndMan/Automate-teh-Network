# Credentials and the scrub's inverse map: the map is the scrub undone
inventories/*/group_vars/all/vault.yml
inventories/*/*_vault.yml
.*-sanitize-map.json

# Phase 3: collected configurations and facts are output, not source
.artifacts/

# Python: interpreter and tool caches are per-machine state, not source
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
